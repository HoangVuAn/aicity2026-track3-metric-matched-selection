# ── Generated data & artifacts (re-created by running the pipeline; never committed) ──
full_run/            # all generated candidate pools (votes / richpool / grounding), pred_f1, serve logs
full_out/            # legacy mode-A output
*.log
*.csv                # submissions / intermediate CSVs live under dataset/, not in the repo

# ── Python ──
__pycache__/
*.pyc
*.pyo

# ── Session analysis / ad-hoc experiments (NOT part of the reproduction pipeline) ──
