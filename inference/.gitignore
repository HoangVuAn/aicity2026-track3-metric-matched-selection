audit_*.py
pair_orient.py
prune_sweep.py
stage_fix2.sh
stage_leakonly.sh

# ── Superseded orchestrators — run_full_fast.sh is the canonical, self-contained one ──
run_faithful.sh                 # still calls training/qwen_sft/*.sh
# Split-stage scripts: run_full_fast.sh now does grounding + judge + final INLINE, so these
